; =====================================================================
; PharmFlow config.ini
; Copy this file to config.ini and fill in the values marked CHANGE_ME
; =====================================================================

[Agent]
; SHADOW = safe testing (read + log only). LIVE = also push to cloud queue.
MODE = SHADOW
POLL_INTERVAL_SEC = 5
AGENT_VERSION = 1.4.0
; Same name on every PC of this pharmacy (e.g. henderson). Prevents duplicates.
STORE_ID = default
; NEW_ONLY = ignore old pending rows on first run. ALL = process backlog too.
START_MODE = NEW_ONLY
REQUIRE_PLAN = false
WAIT_HOURS = 24
# Read faxes in Kroll's Inbound Docs (before staff open them) and OCR them in the cloud. Read-only.
INBOUND_FAX = true
INBOUND_FAX_HOURS = 24
# Comma list of sender numbers to skip (e.g. your own fax number). Empty = read all.
INBOUND_FAX_IGNORE =

[Database]
; Connection to the Kroll SQL Server (read-only login recommended)
SERVER = localhost
DATABASE = Pharmacy
UID = rx
PWD = CHANGE_ME_strong_password
DRIVER = ODBC Driver 17 for SQL Server
TRUST_SERVER_CERTIFICATE = true

[Cloud]
; Your Vercel app URL + the AGENT_API_KEY you set in Vercel env vars
API_URL = https://pharmaflow-swart.vercel.app/api/sync-queue
API_KEY = CHANGE_ME_long_random_token   ; create one with: python flow.py --gen-key

; ---------------------------------------------------------------------
; Schema mapping — run:  python flow.py --discover
; Then override any names that differ on this pharmacy's Kroll install.
; ---------------------------------------------------------------------
[Schema]
pending_table = dbo.PendingNewRx
pending_id = Id
pending_pat_id = PatId
pending_doc_id = DocId
pending_drug_id = DrgId
pending_qty = DispQty
pending_refills = UnlimitedRefills
pending_sig = Sig
pending_created = WrittenDate
pending_script_image_id = ScriptImageId
pending_status = Status
pending_status_value = 1
pat_table = dbo.Pat
pat_id = ID
pat_first = FirstName
pat_last = LastName
pat_dob = Birthday
addr_table = dbo.PatAdd
addr_pat_id = PatID
addr_line = Address1
addr_primary_col = UseForBilling
plan_table = dbo.PatPln
plan_pat_id = PatID
plan_id = SubPlanID
plan_seq_col = Sequence
plan_deleted_col = Deleted
doc_table = dbo.Doc
doc_id = ID
doc_first = FirstName
doc_last = LastName
lic_table = dbo.DocLicence
lic_doc_id = DocID
lic_num = Licence
; Leave image_table blank — the agent auto-detects ScriptImage / ScriptImageContent
; image_table =
; image_id =
; image_data =

[Helper]
; Used only by workstation_helper.py on pharmacist PCs
ALLOWED_ORIGINS = http://localhost:5173,https://pharmaflow-swart.vercel.app
TOKEN =
REQUIRE_WINDOW_CHECK = true
; The helper only types when the active window title contains this text. Find yours with:
;   python workstation_helper.py --show-window
; (your Kroll screens may be titled e.g. "2-Start Screen", not "Kroll")
WINDOW_KROLL =
STEP_DELAY_SEC = 0.4

[RxSchema]
rx_table = dbo.Rx
rx_id = ID
rx_pat_id = PatID
rx_doc_id = DocID
rx_drug_id = DrgID
rx_qty = DispQty
rx_refills = UnlimitedRefills
rx_sig = SIG
rx_created = FillDate

[Shadow]
GO_LIVE_MIN_MATCH = 0.995
GO_LIVE_MIN_SAMPLES = 200
GO_LIVE_MIN_AUTO_RATE = 0.80
AUTO_LEARN = true

[Learning]
; Permanent memory in learning.db. Needs [RxSchema] filled in (finished prescriptions are the teacher).
ENABLED = true
; Apply a learned sig fix automatically after staff made the SAME fix this many times for the SAME drug.
; 0 = never rewrite, only show hints.
SIG_APPLY_MIN_HITS = 2
; true = only wording/note fixes (LU codes, NOT COVERED, ...) are auto-applied; dose/number/frequency changes stay hints.
SIG_APPLY_SAFE_ONLY = true
SQL_LEARN_EVERY_SEC = 900
SQL_BACKFILL_DAYS = 365
SQL_BACKFILL_ROWS = 300000
; Suggest a sig for a blank one only when it is the clear favourite for that drug / prescriber.
SUGGEST_MIN_SAMPLES = 5
SUGGEST_MIN_SHARE = 0.6
