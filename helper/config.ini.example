[Agent]
; SHADOW = read Kroll + log IDs only, sends NOTHING to the cloud (use this first)
; LIVE   = also push to the cloud API
MODE = SHADOW
POLL_INTERVAL_SEC = 5
AGENT_VERSION = 1.1.0
; Same name on every PC of this pharmacy (e.g. henderson). Prevents duplicate rows.
STORE_ID = default
; NEW_ONLY = on the very first run ignore the old pending rows and only watch new ones.
; ALL = process the whole backlog first.
START_MODE = NEW_ONLY
; true = a missing insurance plan makes the row an EXCEPTION. Keep false until PatPln columns are verified.
REQUIRE_PLAN = false

[Database]
SERVER = localhost
DATABASE = Pharmacy
UID = rx
PWD = CHANGE_ME_strong_password
DRIVER = ODBC Driver 17 for SQL Server
; Set to false if the server has a properly trusted certificate
TRUST_SERVER_CERTIFICATE = true

[Cloud]
; must be https://  (only needed in LIVE mode)
API_URL = https://pharmaflow-swart.vercel.app/api/sync-queue
API_KEY = CHANGE_ME_long_random_token
; Only if Vercel Deployment Protection blocks the API URL (see docs/SETUP.md)
; VERCEL_BYPASS_TOKEN =

; Run `python flow.py --discover` on the Kroll server, then override any names
; that differ. Everything below shows the defaults, commented out.
[Schema]
; Verified against this pharmacy's Kroll (PendingNewRx / PatAdd / PatPln column lists).
pending_table = dbo.PendingNewRx
pending_id = Id
pending_pat_id = PatId
pending_doc_id = DocId
; DrgId = Kroll's internal drug id. DIN is often empty on pending rows. Check with: python flow.py --profile PendingNewRx
pending_drug_id = DrgId
pending_qty = DispQty
pending_refills = UnlimitedRefills
pending_sig = Sig
pending_created = WrittenDate
pending_status = Status
; Status is numeric in this Kroll: 1 = new/waiting (checked against live counts)
pending_status_value = 1
pat_table = dbo.Pat
pat_id = ID
pat_first = FirstName
pat_last = LastName
pat_dob = Birthday
addr_table = dbo.PatAdd
addr_pat_id = PatID
addr_line = Address1
addr_primary_col = UseForBilling
plan_table = dbo.PatPln
plan_pat_id = PatID
; PatPln.PlanID is empty in this Kroll; SubPlanID is the filled column
plan_id = SubPlanID
plan_seq_col = Sequence
plan_deleted_col = Deleted
doc_table = dbo.Doc
doc_id = ID
doc_first = FirstName
doc_last = LastName
lic_table = dbo.DocLicence
lic_doc_id = DocID
lic_num = Licence

[Helper]
; Origins allowed to call the keystroke helper (comma separated, no trailing /)
ALLOWED_ORIGINS = http://localhost:5173,https://pharmaflow-swart.vercel.app
; Shared secret; paste the same value in PharmFlow > Settings > Helper token
TOKEN =
; Refuse to type unless the focused window title contains the PMS name
REQUIRE_WINDOW_CHECK = true
; WINDOW_KROLL = kroll
STEP_DELAY_SEC = 0.4

; --- Shadow week: where the FINISHED prescriptions live (used by `flow.py --shadow-report`, read-only).
; Fill from schema_report.txt. rx_link_col is the column holding the PendingRxId, if Kroll keeps one;
; otherwise matching uses patient + drug + rx_created after the pending date.
[RxSchema]
; What staff actually entered in Kroll (dbo.Rx). No link column exists, so flow.py matches on
; patient + drug + filled on/after the day the pending Rx was first seen.
rx_table = dbo.Rx
rx_pat_id = PatID
rx_doc_id = DocID
rx_drug_id = DrgID
rx_qty = DispQty
rx_refills = UnlimitedRefills
rx_sig = SIG
rx_created = FillDate

[Shadow]
; the report says READY only if all of these hold
GO_LIVE_MIN_MATCH = 0.995
GO_LIVE_MIN_SAMPLES = 200
GO_LIVE_MIN_AUTO_RATE = 0.80
