SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=        # for /api/extract (Live Vision extraction)
EXTRACT_ACCESS_TOKEN=     # >= 16 random chars; paste in PharmFlow > Settings > API access token
